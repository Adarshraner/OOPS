#include<iostream>
using namespace std;

class student
{
	public:
	int rollno;
	string name;
	string branch;
	
	void Student()
	{
		cout<<"Enter Roll No:";
		cin>>rollno;
		
		cout<<"Enter Name:";
		cin>>name;
		
		cout<<"Enter Branch:";
		cin>>branch;
	}
	void display()
	{
		cout<<"=====Student Details====="<<endl;
		
		cout<<"Roll No:"<<rollno<<endl;
		cout<<"Name:"<<name<<endl;
		cout<<"Branch:"<<branch<<endl;
	}
};

int main()
{
	student s1;
	
	s1.Student();
	s1.display();
	
	return 0;
}
