#include<iostream>
using namespace std;

class book
{
	public:
	int bookid;
	string book_name;
	float price;
	
	void getdetails()
	{
		cout<<"Book ID:";
		cin>>bookid;
		
		cout<<"Book_Name:";
		cin>>book_name;
		
		cout<<"Price:";
		cin>>price;
	}
	void display()
	{
		cout<<"======BOOK DETAILS======"<<endl;
		cout<<"Book ID="<<bookid<<endl;
		cout<<"Book_Name="<<book_name<<endl;
		
		cout<<"Price="<<price<<endl;
	}
};
int main()
{
	book b1;
	b1.getdetails();
	b1.display();
	
	return 0;
}
